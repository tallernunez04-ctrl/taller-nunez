rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // mismo allowlist que Firestore: usuarios/{email} con activo == true
    function usuario() {
      return firestore.get(/databases/(default)/documents/usuarios/$(request.auth.token.email)).data;
    }
    function activo() {
      return request.auth != null && usuario().activo == true;
    }
    function rol() { return usuario().rol; }

    // adjuntos de cobranza de viajes (facturas, XML, comprobantes)
    match /viajes/{viajeId}/{archivo} {
      allow read: if activo();
      allow write: if activo() && rol() == 'admin'
        && request.resource.size < 10 * 1024 * 1024;
    }

    // adjuntos de compras (facturas de proveedor, comprobantes de pago)
    match /compras/{compraId}/{archivo} {
      allow read: if activo();
      allow write: if activo() && rol() in ['compras', 'admin']
        && request.resource.size < 10 * 1024 * 1024;
    }

    // comprobantes de nómina
    match /nominas/{nominaId}/{archivo} {
      allow read: if activo() && rol() == 'admin';
      allow write: if activo() && rol() == 'admin'
        && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
