rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function email() { return request.auth.token.email; }
    function existeUsuario() {
      return request.auth != null && exists(/databases/$(db)/documents/usuarios/$(email()));
    }
    function usuario() {
      return get(/databases/$(db)/documents/usuarios/$(email())).data;
    }
    function activo() { return existeUsuario() && usuario().activo == true; }
    function rol() { return usuario().rol; }

    match /usuarios/{correo} {
      // el propio doc (necesario para el allowlist) o admin (pantalla Usuarios)
      allow read: if request.auth != null && (email() == correo || (activo() && rol() == 'admin'));
      allow write: if activo() && rol() == 'admin';
    }

    match /workOrders/{id} {
      allow create: if activo() && (rol() == 'admin'
        || (rol() == 'taller' && request.resource.data.creadoPor == email()));
      allow update: if activo() && (rol() == 'admin'
        || (rol() == 'taller' && resource.data.creadoPor == email()
            && resource.data.estatus == 'en_proceso'));
      allow read: if activo() && (rol() in ['compras', 'admin']
        || (rol() == 'taller' && resource.data.creadoPor == email()));
    }

    match /compras/{id} {
      allow read, write: if activo() && rol() in ['compras', 'admin'];
    }

    match /unidades/{id} {
      allow read: if activo();
      allow write: if activo() && rol() in ['compras', 'admin'];
      // chofer solo actualiza lectura y rendimientos (transacción de carga de diésel)
      allow update: if activo() && rol() == 'chofer'
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['ultimaLectura', 'ultimosRendimientos', 'rendimientoPromedio', 'rendimientoMediana']);
    }

    match /cargasDiesel/{id} {
      allow create: if activo() && (rol() == 'admin'
        || (rol() == 'chofer' && request.resource.data.operadorEmail == email()));
      allow read: if activo() && (rol() in ['taller', 'compras', 'admin']
        || (rol() == 'chofer' && resource.data.operadorEmail == email()));
    }

    match /reportesFalla/{id} {
      allow create: if activo() && request.resource.data.operadorEmail == email();
      allow read: if activo() && (rol() in ['taller', 'compras', 'admin']
        || resource.data.operadorEmail == email());
      // taller/admin marcan atendido
      allow update: if activo() && rol() in ['taller', 'admin'];
    }

    match /operadores/{id} {
      allow read: if activo();
      allow write: if activo() && rol() == 'admin';
    }

    match /clientes/{id} {
      allow read: if activo();
      allow write: if activo() && rol() == 'admin';
      match /direcciones/{dirId} {
        allow read: if activo();
        allow write: if activo() && rol() == 'admin';
      }
    }

    match /proveedores/{id} {
      allow read: if activo();
      allow write: if activo() && rol() in ['compras', 'admin'];
    }

    match /tabuladores/{id} {
      allow read: if activo();
      allow write: if activo() && rol() == 'admin';
    }

    match /viajes/{id} {
      // el chofer del viaje es el del movimiento activo (operadorEmail legacy se
      // mantiene sincronizado con choferActualEmail en la transacción de cambio)
      function esChoferDelViaje() {
        return get(/databases/$(db)/documents/viajes/$(id)).data.operadorEmail == email();
      }
      allow create, delete: if activo() && rol() == 'admin';
      // un viaje no puede pasar a terminado con entregas pendientes
      allow update: if activo() && rol() == 'admin'
        && (request.resource.data.get('estatus', '') != 'terminado'
            || request.resource.data.get('entregasPendientes', 0) == 0);
      // el chofer solo decrementa el contador al marcar una entrega (transacción)
      allow update: if activo() && rol() == 'chofer'
        && resource.data.operadorEmail == email()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['entregasPendientes']);
      allow read: if activo() && (rol() in ['compras', 'admin']
        || resource.data.operadorEmail == email()
        || resource.data.get('choferActualEmail', '') == email());

      match /entregas/{entregaId} {
        allow read: if activo() && (rol() in ['compras', 'admin']
          || (rol() == 'chofer' && esChoferDelViaje()));
        allow create, delete: if activo() && rol() == 'admin';
        // el chofer solo marca la entrega y adjunta evidencia
        allow update: if activo() && (rol() == 'admin'
          || (rol() == 'chofer' && esChoferDelViaje()
              && request.resource.data.diff(resource.data).affectedKeys()
                .hasOnly(['estatus', 'fechaHoraEntregaReal', 'evidenciaUrl'])));
      }

      match /movimientos/{movId} {
        allow read: if activo() && (rol() in ['compras', 'admin']
          || (rol() == 'chofer' && esChoferDelViaje()));
        allow write: if activo() && rol() == 'admin';
      }
    }

    match /empleados/{id} {
      allow read, write: if activo() && rol() == 'admin';
    }

    match /nominas/{id} {
      allow read, write: if activo() && rol() == 'admin';
      match /detalles/{detalleId} {
        allow read, write: if activo() && rol() == 'admin';
      }
    }

    // totales consolidados por mes (dashboard de conciliación)
    match /balances/{mes} {
      allow read: if activo() && rol() == 'admin';
      allow write: if activo() && rol() in ['compras', 'admin'];
    }

    match /config/{id} {
      allow read: if activo();
      allow write: if activo() && rol() == 'admin';
      // taller necesita incrementar ultimoWO (transacción de numeración), nada más
      allow update: if activo() && rol() == 'taller'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoWO']);
      // compras solo incrementa el folio de PO
      allow update: if activo() && rol() == 'compras'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ultimoPO']);
    }
  }
}
